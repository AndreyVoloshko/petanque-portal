# the upstream component nginx needs to connect to
upstream django {
    server {{ web_api_container_name }}:{{ web_api_container_internal_port }}; # stream using http server due to app is running in separate container
}

# configuration of the server
server {

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # the port your site will be served on, default_server indicates that this server block
    # is the block to use if no blocks match the server_name
    listen      {{ nginx_container_internal_port }} default_server;

    server_name portal.petanque.org.ua;

    # the domain name it will serve for
    # server_name .example.com; # substitute your machine's IP address or FQDN
    charset     utf-8;

    # max upload size
    client_max_body_size 1024M;   # adjust to taste

    # Static
    location /static/ {
        alias /application/static/;
        gzip_static on;
        expires max;
        add_header Cache-Control public;
    }

    # Static
    location /media/images/ {
        alias /application/media/images/;
        gzip_static on;
        expires max;
        add_header Cache-Control public;
    }

    # Finally, send all non-media requests to the Flask server.
    location / {
        proxy_pass  http://django;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
    }
}

server {
    listen 443 ssl;

    server_name portal.petanque.org.ua;

    ssl_certificate /etc/letsencrypt/live/portal.petanque.org.ua/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/portal.petanque.org.ua/privkey.pem;

    # Static
    location /static/ {
        alias /application/static/;
        gzip_static on;
        expires max;
        add_header Cache-Control public;
    }

    # Static
    location /media/images/ {
        alias /application/media/images/;
        gzip_static on;
        expires max;
        add_header Cache-Control public;
    }

    location / {
        proxy_pass http://django;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
    }
}