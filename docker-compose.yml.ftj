version: '3.1'
services:
  {{ web_api_container_name }}:
    build:
      context: ./components/web-api/
      dockerfile: Dockerfile.service
    ports:
     - "{{ web_api_container_external_port }}:{{ web_api_container_internal_port }}"
    volumes:
     - {{ uploaded_files_volume_name }}:{{ uploaded_file_volume_mounting_point }}
    depends_on:
     - {{ db_container_name }}

  {{ nginx_container_name }}:
    build:
      context: ./components/web-api/
      dockerfile: Dockerfile.nginx
    ports:
     - "{{ nginx_container_external_port }}:{{ nginx_container_internal_port }}"
    volumes:
     - {{ uploaded_files_volume_name }}:{{ uploaded_file_volume_mounting_point }}
    depends_on:
     - {{ web_api_container_name }}

  {{ db_container_name }}:
    image: postgres:{{ db_container_engine_version }}
    volumes:
     - {{ db_container_data_volume_name }}:/var/lib/postgresql/data

  {{ adminer_container_name }}:
    image: adminer
    restart: always
    ports:
      - {{ adminer_container_external_port }}:{{ adminer_container_internal_port }}

volumes:
  {{ db_container_data_volume_name }}:
  {{ uploaded_files_volume_name }}: